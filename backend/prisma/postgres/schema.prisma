generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  fullName         String
  role             Role            @default(STUDENT)
  isVerified       Boolean         @default(false)
  twoFactorEnabled Boolean         @default(false)
  banUntil         DateTime?
  googleId         String?         @unique
  githubId         String?         @unique
  otp              String?
  otpExpiry        DateTime?
  avatar           String?
  bio              String?
  location         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  documents        Document[]
  livestreams      LiveStream[]
  reportsFiled     Report[]        @relation("ReportReporter")
  reportsReceived  Report[]        @relation("ReportReported")
  reportsReviewed  Report[]        @relation("ReportReviewer")
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?

  @@map("users")
}

model TeacherProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  cvUrl           String?
  subjects        String[]
  experience      Int?
  education       String?
  totalStudents   Int               @default(0)
  rating          Float             @default(0)
  website         String?
  linkedin        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approvedAt      DateTime?
  isApproved      Boolean           @default(false)
  rejectedAt      DateTime?
  rejectionReason String?
  followers       FollowedTeacher[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model StudentProfile {
  id                     String            @id @default(uuid())
  userId                 String            @unique
  grade                  String?
  school                 String?
  interests              String[]
  studyHours             Int               @default(0)
  studyStreak            Int               @default(0)
  learningGoals          String[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  lastActivityDate       DateTime?
  followedTeachers       FollowedTeacher[]
  receivedFriendRequests FriendList[]      @relation("ReceivedFriendRequests")
  sentFriendRequests     FriendList[]      @relation("SentFriendRequests")
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model FriendList {
  id         String         @id @default(uuid())
  requestId  String
  receiverId String
  status     FriendStatus   @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  receiver   StudentProfile @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  requester  StudentProfile @relation("SentFriendRequests", fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, receiverId])
  @@index([requestId, status])
  @@index([receiverId, status])
  @@index([status])
  @@map("friend_lists")
}

model FollowedTeacher {
  id        String         @id @default(uuid())
  studentId String
  teacherId String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@map("followed_teachers")
}

model LiveStream {
  id               String                  @id @default(uuid())
  teacherId        String
  title            String
  description      String?
  thumbnail        String?
  audioUrl         String?
  status           LiveStreamStatus        @default(SCHEDULED)
  recordingUrl     String?
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  currentViewers   Int                     @default(0)
  totalViews       Int                     @default(0)
  peakViewers      Int                     @default(0)
  duration         Int                     @default(0)
  isRecorded       Boolean                 @default(true)
  isApprove        RecordingApprovalStatus @default(FALSE)
  processingStatus ProcessingStatus        @default(PENDING)
  isPublic         Boolean                 @default(true)
  allowComments    Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  category         String?
  rejectReason     String?
  teacher          User                    @relation(fields: [teacherId], references: [id])
  schedule         Schedule?
  tags             Tag[]

  @@index([teacherId, status])
  @@index([scheduledAt])
  @@index([status])
  @@map("livestreams")
}

model Document {
  id               String                  @id @default(uuid())
  title            String
  description      String?
  fileUrl          String
  audioUrl         String?
  fileType         String
  fileSize         Int
  mimeType         String
  uploadedAt       DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  fileName         String
  teacherId        String
  thumbnail        String?
  isApprove        RecordingApprovalStatus @default(FALSE)
  processingStatus ProcessingStatus        @default(PENDING)
  teacher          User                    @relation(fields: [teacherId], references: [id])

  @@index([fileType])
  @@index([teacherId])
  @@map("documents")
}

model Tag {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  description  String?
  color        String?
  livestreamId String
  createdAt    DateTime   @default(now())
  livestream   LiveStream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@map("tags")
}

model Schedule {
  id             String         @id @default(uuid())
  teacherId      String
  title          String
  startTime      DateTime
  endTime        DateTime
  livestreamId   String?        @unique
  notifyBefore   Int            @default(15)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cancelReason   String?
  cancelledAt    DateTime?
  color          String?
  isPublic       Boolean        @default(true)
  reminderSent   Boolean        @default(false)
  reminderSentAt DateTime?
  status         ScheduleStatus @default(SCHEDULED)
  tags           String[]
  liveStream     LiveStream?    @relation(fields: [livestreamId], references: [id])

  @@index([teacherId, startTime])
  @@index([livestreamId])
  @@index([status])
  @@index([isPublic])
  @@map("schedules")
}

model PendingRegistration {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(STUDENT)
  otp       String
  otpExpiry DateTime
  createdAt DateTime @default(now())

  @@map("pending_registrations")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reportedId  String
  type        ReportType
  category    String
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  screenshots String[]
  metadata    Json?
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reporter    User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reported    User         @relation("ReportReported", fields: [reportedId], references: [id])
  reviewer    User?        @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([reportedId, status])
  @@index([status])
  @@map("reports")
}

enum RecordingApprovalStatus {
  TRUE
  FALSE
  REJECTED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReportType {
  USER
  LIVESTREAM
  COMMENT
  MESSAGE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}
