// MongoDB Schema - For Real-time Data
generator mongoClient {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/mongodb-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource mongodb {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model ChatMessage {
  id          String        @id @default(auto()) @map("_id") @mongodb.ObjectId
  senderId    String
  receiverId  String
  content     String
  type        MessageType   @default(TEXT)
  status      MessageStatus @default(SENT)
  attachments String[]
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([senderId, receiverId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

// Live Stream Chat
model LiveStreamChat {
  id           String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  userId       String
  username     String
  userAvatar   String?
  message      String
  type         ChatType @default(MESSAGE)
  createdAt    DateTime @default(now())

  @@index([livestreamId, createdAt])
  @@map("livestream_chats")
}

enum ChatType {
  MESSAGE
  SYSTEM
  GIFT
  SUPER_CHAT
}

// Notifications
model Notification {
  id        String           @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId    String
  type      NotificationType
  title     String
  content   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  NEW_FOLLOWER
  NEW_MESSAGE
  LIVESTREAM_START
  COURSE_UPDATE
  COMMENT
  LIKE
  SYSTEM
}

// User Activity Logs
model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

// Live Stream Documents (which documents are shared in livestream)
model LiveStreamDocuments {
  id           String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String   @unique
  documentIds  String[] // Array of document IDs from PostgreSQL

  // Metadata for each shared document
  sharedDocuments Json[] // [{documentId, sharedAt, order}, ...]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("livestream_documents")
}

// Schedule Analytics and Reminders
model ScheduleNotification {
  id         String @id @default(auto()) @map("_id") @mongodb.ObjectId
  scheduleId String @unique

  // Reminder tracking
  reminders ScheduleReminder[]

  // Attendee tracking
  attendees ScheduleAttendee[]

  // Engagement metrics
  viewsCount      Int @default(0)
  clicksCount     Int @default(0)
  registeredCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedule_notifications")
}

// Embedded types for schedule notifications
type ScheduleReminder {
  userId    String
  sentAt    DateTime
  method    String // email, push, sms
  opened    Boolean   @default(false)
  openedAt  DateTime?
  clicked   Boolean   @default(false)
  clickedAt DateTime?
}

type ScheduleAttendee {
  userId       String
  registeredAt DateTime
  attended     Boolean   @default(false)
  attendedAt   DateTime?
  leftAt       DateTime?
  duration     Int? // in seconds
}

// Live Stream Sessions (for analytics)
model LiveStreamSession {
  id           String    @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  viewerId     String
  viewerName   String?
  viewerAvatar String?
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  duration     Int? // in seconds
  interactions Int       @default(0)

  // Additional tracking
  deviceType String? // mobile, desktop, tablet
  browser    String?
  location   String? // country/city
  referrer   String?

  @@index([livestreamId, viewerId])
  @@index([livestreamId, joinedAt])
  @@map("livestream_sessions")
}

// Live Stream Analytics (aggregated)
model LiveStreamAnalytics {
  id           String @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String @unique

  // Viewer stats
  totalViews    Int   @default(0)
  uniqueViewers Int   @default(0)
  peakViewers   Int   @default(0)
  avgWatchTime  Float @default(0) // in minutes

  // Engagement stats
  totalComments  Int @default(0)
  totalLikes     Int @default(0)
  totalShares    Int @default(0)
  totalQuestions Int @default(0)

  // Demographics
  viewersByDevice  Json? // {mobile: 50, desktop: 30, tablet: 20}
  viewersByCountry Json? // {VN: 80, US: 10, ...}

  // Time series data
  viewerTimeline Json? // [{timestamp, count}, ...]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("livestream_analytics")
}

// Q&A During Livestream
model Question {
  id            String         @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId  String
  studentId     String
  studentName   String
  studentAvatar String?
  question      String
  status        QuestionStatus @default(PENDING)

  // Answer
  answeredBy String?
  answer     String?
  answeredAt DateTime?

  // Engagement
  upvotes       Int      @default(0)
  upvotedBy     String[] // Array of user IDs
  isHighlighted Boolean  @default(false)
  isPinned      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([livestreamId, status])
  @@index([livestreamId, createdAt])
  @@map("questions")
}

enum QuestionStatus {
  PENDING
  ANSWERED
  DISMISSED
}

// Reactions/Emojis during livestream
model Reaction {
  id           String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  userId       String
  emoji        String
  timestamp    DateTime @default(now())

  @@index([livestreamId, timestamp])
  @@map("reactions")
}

// Watch history
model WatchHistory {
  id           String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId       String
  livestreamId String
  watchedAt    DateTime @default(now())
  duration     Int // in seconds
  completed    Boolean  @default(false)
  progress     Float    @default(0) // 0-100%

  // Resume point
  lastPosition Int @default(0) // in seconds

  @@unique([userId, livestreamId])
  @@index([userId, watchedAt])
  @@index([livestreamId])
  @@map("watch_history")
}

// Notebook/Notes taken during livestream
model Notebook {
  id           String  @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId       String
  livestreamId String
  title        String?
  content      String
  timestamp    Int? // at what point in video (seconds)

  // Organization
  tags      String[]
  isPrivate Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, livestreamId])
  @@index([userId, createdAt])
  @@map("notebooks")
}

// Comments on recorded livestreams
model Comment {
  id           String  @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  userId       String
  userName     String
  userAvatar   String?
  content      String
  timestamp    Int? // at what point in video (seconds)

  // Thread support
  parentId String? // for replies
  replies  Int     @default(0)

  // Engagement
  likes   Int      @default(0)
  likedBy String[] // Array of user IDs

  // Moderation
  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)
  isPinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([livestreamId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

// Real-time User Presence
model UserPresence {
  id       String     @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId   String     @unique
  status   UserStatus @default(OFFLINE)
  lastSeen DateTime   @default(now())
  socketId String?
  metadata Json?

  @@index([status])
  @@map("user_presences")
}

enum UserStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
}

// Student Notebook - Saved documents from livestreams
model StudentNotebook {
  id           String @id @default(auto()) @map("_id") @mongodb.ObjectId
  studentId    String
  livestreamId String
  documentId   String // ID of the document (from teacher upload)

  // Document metadata (cached for quick access)
  title    String
  filename String
  fileType String
  fileUrl  String
  fileSize Int?

  // Student customization
  notes    String?
  tags     String[]
  isPinned Boolean  @default(false)
  folder   String?  @default("Livestream Materials")

  // Timestamps
  savedAt        DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@unique([studentId, documentId, livestreamId])
  @@index([studentId])
  @@index([livestreamId])
  @@index([studentId, isPinned])
  @@map("student_notebooks")
}

// Video Comments - Student comments on recorded livestreams
model VideoComment {
  id           String  @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  studentId    String
  author       String // Student's full name
  authorAvatar String? // Student's avatar URL
  content      String
  likes        Int     @default(0)
  dislikes     Int     @default(0)

  // Track individual reactions per user
  likedBy    String[] // Array of student IDs who liked this comment
  dislikedBy String[] // Array of student IDs who disliked this comment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([livestreamId, createdAt])
  @@index([studentId])
  @@map("video_comments")
}

// Video Reactions - Track likes and dislikes on videos by students
model VideoReaction {
  id           String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  livestreamId String
  studentId    String
  reactionType String // 'like' or 'dislike'
  createdAt    DateTime @default(now())

  @@unique([livestreamId, studentId])
  @@index([livestreamId])
  @@index([studentId])
  @@map("video_reactions")
}

// AI analysis cache per recording/livestream
model AiTranscriptSummary {
  id                    String         @id @default(auto()) @map("_id") @mongodb.ObjectId
  type                  TranscriptType
  recordingId           String?
  documentId            String?
  transcript            Json?
  summary               String?
  moderationResult      Json?
  moderationCheckedAt   DateTime?      
  transcriptGeneratedAt DateTime?
  summaryGeneratedAt    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([recordingId])
  @@index([documentId])
  @@map("ai_transcript_summary")
}

// Learning streak state per user
model LearningStreak {
  id                String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId            String   @unique
  timezone          String   @default("UTC")
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastLearningDate  String?
  totalLearningDays Int      @default(0)
  streakFreezes     Int      @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([currentStreak])
  @@map("learning_streaks")
}

// One awarded learning day per user/date_key (YYYY-MM-DD in user's timezone)
model LearningStreakDay {
  id              String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId          String
  dateKey         String
  sourceSessionId String?
  awarded         Boolean  @default(true)
  freezeConsumed  Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
  @@index([dateKey])
  @@map("learning_streak_days")
}

// Aggregated learning activity per user/video/day for anti-exploit qualification
model LearningSession {
  id                   String               @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId               String
  videoId              String?
  activityType         LearningActivityType
  activeWatchSeconds   Int                  @default(0)
  completionPercentage Float                @default(0)
  qualifiedForStreak   Boolean              @default(false)
  sessionDateKey       String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([userId, sessionDateKey, videoId])
  @@index([userId, sessionDateKey])
  @@index([qualifiedForStreak])
  @@map("learning_sessions")
}

enum TranscriptType {
  LIVESTREAM
  DOCUMENT
}

enum ProcessingStage {
  queued
  preparing
  transcribing
  summarizing
  moderating
  done
  error
}

enum LearningActivityType {
  VIDEO
  QUIZ
  EXERCISE
}

// Personal Activities: learning journal, notes, plans, reactions, comments, XP and badges
model Activity {
  id         String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId     String
  type       String // e.g. status, note_update, plan_milestone, streak
  content    String?
  media      Json? // [{type, url, thumbnail, meta}]
  attached   Json? // { contentType, contentId }
  hashtags   String[]
  visibility String   @default("public") // public | followers | private
  replyTo    String? // activity id
  pinned     Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([hashtags])
  @@map("activities")
}

model StudyNote {
  id                 String    @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId             String
  title              String
  description        String?
  status             String    @default("planned") // planned|in_progress|paused|completed
  progressPercentage Int       @default(0)
  visibility         String    @default("private")
  startedAt          DateTime?
  completedAt        DateTime?
  isTemplate         Boolean   @default(false)
  tags               String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([isTemplate])
  @@map("study_notes")
}

model StudyNoteTask {
  id          String    @id @default(auto()) @map("_id") @mongodb.ObjectId
  noteId      String
  title       String
  details     String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  orderIndex  Int       @default(0)
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([noteId, orderIndex])
  @@map("study_note_tasks")
}

model ActivityReaction {
  id         String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  activityId String
  userId     String
  type       String // e.g. motivated, clap, keep_going, rocket
  createdAt  DateTime @default(now())

  @@unique([activityId, userId, type])
  @@index([activityId])
  @@map("activity_reactions")
}

model ActivityComment {
  id         String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  activityId String
  userId     String
  content    String
  parentId   String?
  likeCount  Int      @default(0)
  likedBy    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([activityId, createdAt])
  @@map("activity_comments")
}

model XpEntry {
  id        String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId    String
  source    String // e.g. task_complete, note_complete, streak
  sourceId  String? // related resource id
  amount    Int
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_ledger")
}

model Badge {
  id          String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  code        String   @unique
  title       String
  description String?
  icon        String?
  criteria    Json? // expression or rule descriptor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  userId    String
  badgeCode String
  awardedAt DateTime @default(now())
  metadata  Json?

  @@unique([userId, badgeCode])
  @@index([userId])
  @@map("user_badges")
}

model SharedPlan {
  id         String   @id @default(auto()) @map("_id") @mongodb.ObjectId
  sourceNote String // study note id
  ownerId    String
  title      String
  visibility String   @default("public")
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@map("shared_plans")
}
